# Copia este archivo como .env en tu proyecto local
# En Vercel agrega estas variables en Settings > Environment Variables

# URL del Web App de Google Apps Script (la obtienes al desplegarlo)
VITE_SCRIPT_URL=https://script.google.com/macros/s/TU_ID_AQUI/exec

# Token de sincronización (debe coincidir con la PROPIEDAD DE SCRIPT
# `SB_SYNC_TOKEN`, no con nada del código: Editor → Propiedades del
# proyecto → Propiedades de script. El repositorio es público.)
VITE_TOKEN=CAMBIA_ESTE_TOKEN

# ── Branding (opcional; hay valores por defecto en src/App.jsx) ──
# Nombre del negocio (se usa en <title> y encabezados)
# ⚠️ OBLIGATORIO en un despliegue nuevo: es lo único de la marca que
#    queda escrito en el código (por defecto «SZ», el despliegue original).
VITE_BIZ_NAME=Mi Negocio
# Subtítulo corto (opcional)
VITE_BIZ_SUBTITLE=
# Emoji del favicon (se inyecta en runtime, NO en index.html)
VITE_BIZ_EMOJI=🌸
# URL absoluta de logo para apple-touch-icon (opcional).
# Si el repo es PRIVADO, usa el logo del repo público LOGOS (si no, la URL
# rompería al cerrar el repo): https://github.com/bryanm92s/LOGOS
VITE_BIZ_LOGO=

# ── Catálogo inicial de servicios ──
# Preset: cejas | unas | peluqueria | barberia | depilacion | masajes | estetica | maquillaje  (ver src/catalogs.js)
# Es el catálogo con el que ARRANCA el programa cuando aún no hay datos.
# Si no se define, se usa el histórico de cejas y pestañas.
VITE_CATALOG=cejas
# O (gana sobre VITE_CATALOG): tus servicios exactos en JSON.
# Debe ser una lista; si está rota, el programa cae al preset.
# VITE_DEFAULT_SERVICES=[{"name":"Corte","price":45000,"duration":60}]

# ── Reportes (opcional) ──
# Número de WhatsApp del administrador, destino del botón «💬 WhatsApp
# admin» del reporte. Solo dígitos, con o sin prefijo de país (se le
# agrega 57 automáticamente si no lo trae). NO se muestra en la interfaz
# y ya NO hay número por defecto en el código: si falta, el botón sale
# deshabilitado.
VITE_ADMIN_WHATSAPP=322XXXXXXX
